# Copy this file to agent-runner.toml beside the git repo, not inside it.
# Edit that copy. --config opens agent-runner.toml, not this example.
# Replace WORK and PI. WORK is the absolute repo path. A relative path
# resolves against this file's directory. Replace PROVIDER/MODEL.
# The cold command already narrows the child CLI. The delay script must
# not add or remove that flag. max_rounds is 1. This file has no stop path.

schema_version = 1

[agent]
command = ["PI", "-p", "-na", "--mode", "json", "--model", "PROVIDER/MODEL", "--tools", "read,grep,find,ls"]
prompt_arg_template = ["{prompt}"]
name = "pi"
terminal_marker = "\"type\":\"agent_end\""

[agent.env]
PI_OFFLINE = "1"

[runtime]
work_dir = "WORK"
log_dir = "WORK/logs"
round_budget_s = 1800
restart_delay_s = 60
round_log_retention = 0
max_rounds = 1

[prompt]
# Index 0 is the standing prompt. The ledger is index 1. Do not use the
# single `file =` form.
files = ["prompts/program.md", "logs/lessons.md"]
inject_context = true

[goal]
ledger = "logs/lessons.md"

[vcs]
# ignore: the gap appends a prompt line inside the repo.
# stash would remove that line before a later round. There is no stop path.
dirty_action = "ignore"
stash_idempotency_s = 5
