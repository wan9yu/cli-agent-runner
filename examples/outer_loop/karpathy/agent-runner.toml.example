# Copy this file to agent-runner.toml beside the git repo, not inside it.
# Edit that copy. --config opens agent-runner.toml, not this example.
# Replace WORK and PI. Do not set stop_file.
# The budget is max_rounds. round_budget_s is the per-round wall.
# queue/round2.md is not a prompt path. delay.py reads it as KARPATHY_QUEUE.
# Then serve with --config. Do not loop `agent-runner round`.
# Do not restart on exit 78, 75, or 70.
# Start delay.py before serve. It keeps or discards train.py during the delay.

schema_version = 1

[agent]
command = ["PI", "-p", "-na", "--mode", "json", "--model", "PROVIDER/MODEL"]
prompt_arg_template = ["{prompt}"]
name = "pi"
terminal_marker = "\"type\":\"agent_end\""

[agent.env]
PI_OFFLINE = "1"

[runtime]
work_dir = "WORK"
log_dir = "WORK/logs"
round_budget_s = 1800
restart_delay_s = 60
round_log_retention = 0
max_rounds = 3

[prompt]
files = ["prompts/program.md", "logs/lessons.md"]
inject_context = true

[goal]
ledger = "logs/lessons.md"

[[goal.checks]]
name = "metric"
cmd = ["python3", "train.py"]
timeout_s = 5

[vcs]
# ignore: the child edit must still be in the tree when the delay script
# keeps or discards it. stash is not a discard. Do not git checkout.
dirty_action = "ignore"
stash_idempotency_s = 5
