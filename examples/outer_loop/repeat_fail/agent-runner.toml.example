# Copy this file to agent-runner.toml beside the git repo, not inside it.
# Edit that copy. --config opens agent-runner.toml, not this example.
# Replace WORK, PI, FAIL_SOURCE, and STOP. STOP is an absolute path beside
# the repo and must not exist yet. FAIL_SOURCE is the absolute path of
# fail_source.py, also beside the repo.
# Then serve with --config. Do not loop `agent-runner round`.
# Do not restart on exit 78, 75, or 70.
# Start delay.py before serve. It creates STOP only after a second
# identical red, inside the delay, before round 3.

schema_version = 1

[agent]
command = ["PI", "-p", "-na", "--mode", "json", "--model", "PROVIDER/MODEL"]
prompt_arg_template = ["{prompt}"]
name = "pi"
terminal_marker = "\"type\":\"agent_end\""

[agent.env]
PI_OFFLINE = "1"

[runtime]
work_dir = "WORK"
log_dir = "WORK/logs"
round_budget_s = 1800
restart_delay_s = 60
round_log_retention = 0
max_rounds = 3
stop_file = "STOP"

[prompt]
# Index 0 is the standing prompt. The ledger is index 1. Do not use the
# single `file =` form. fail_source.py is not a prompt path.
files = ["prompts/program.md", "logs/lessons.md"]
inject_context = true

[goal]
ledger = "logs/lessons.md"

[[goal.checks]]
name = "stable"
cmd = ["python3", "FAIL_SOURCE"]
timeout_s = 5

[vcs]
# ignore: the child edit to notes.md must still be in the tree.
# stash is not the stop. This script does not read assistant text.
dirty_action = "ignore"
stash_idempotency_s = 5
