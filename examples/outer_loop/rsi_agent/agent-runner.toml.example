# Copy this file to agent-runner.toml beside the git repo, not inside it.
# Edit that copy. --config opens agent-runner.toml, not this example.
# COURSE is the beside-repo course.md. It is a prompt file after the ledger.
# queue/task-b.md is not a prompt path. delay.py reads it as RSI_QUEUE.
# Replace WORK, PI, and COURSE. Do not set stop_file.
# Then serve with --config. Do not loop `agent-runner round`.
# Do not restart on exit 78, 75, or 70.
# Start delay.py before serve. It appends task B once during the delay.

schema_version = 1

[agent]
command = ["PI", "-p", "-na", "--mode", "json", "--model", "PROVIDER/MODEL"]
prompt_arg_template = ["{prompt}"]
name = "pi"
terminal_marker = "\"type\":\"agent_end\""

[agent.env]
PI_OFFLINE = "1"

[runtime]
work_dir = "WORK"
log_dir = "WORK/logs"
round_budget_s = 1800
restart_delay_s = 60
round_log_retention = 0
max_rounds = 2

[prompt]
# Index 0 is the standing prompt. The ledger is index 1. The course file
# is index 2, outside the repo. Do not use the single `file =` form.
# A missing ledger is skipped. The course file must exist.
files = ["prompts/program.md", "logs/lessons.md", "COURSE"]
inject_context = true

[goal]
ledger = "logs/lessons.md"

[[goal.checks]]
name = "metric"
cmd = ["python3", "actor.py"]
timeout_s = 5

[vcs]
# ignore: the child edit to actor.py must still be in the tree for round 2.
# stash can sweep that edit. This script does not restore actor.py.
dirty_action = "ignore"
stash_idempotency_s = 5
