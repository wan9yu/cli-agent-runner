# Copy this file to agent-runner.toml beside the git repo, not inside it.
# Edit that copy. --config opens agent-runner.toml, not this example.
# PLAYBOOK is the beside-repo playbook.md. It is a prompt file after the
# ledger. It is not the ledger. Replace WORK, PI, and PLAYBOOK.
# Do not set stop_file.
# Then serve with --config. Do not loop `agent-runner round`.
# Do not restart on exit 78, 75, or 70.
# Start delay.py before serve. It appends one bullet during the delay.

schema_version = 1

[agent]
command = ["PI", "-p", "-na", "--mode", "json", "--model", "PROVIDER/MODEL"]
prompt_arg_template = ["{prompt}"]
name = "pi"
terminal_marker = "\"type\":\"agent_end\""

[agent.env]
PI_OFFLINE = "1"

[runtime]
work_dir = "WORK"
log_dir = "WORK/logs"
round_budget_s = 1800
restart_delay_s = 60
round_log_retention = 0
max_rounds = 2

[prompt]
# Index 0 is the standing prompt. The ledger is index 1. The playbook is
# index 2, outside the repo, and is not [goal] ledger. Do not use `file =`.
# A missing ledger is skipped. The playbook must exist.
files = ["prompts/program.md", "logs/lessons.md", "PLAYBOOK"]
inject_context = true

[goal]
ledger = "logs/lessons.md"

[[goal.checks]]
name = "metric"
cmd = ["python3", "generator.py"]
timeout_s = 5

[vcs]
# ignore: the child edit to generator.py must still be in the tree.
# The delay script does not rewrite generator.py or the ledger.
dirty_action = "ignore"
stash_idempotency_s = 5
