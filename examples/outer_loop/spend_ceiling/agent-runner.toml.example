# Copy this file to agent-runner.toml beside the git repo, not inside it.
# Edit that copy. --config opens agent-runner.toml, not this example.
# Replace WORK, PI, and STOP. WORK and STOP are absolute paths. STOP is
# beside the repo and must not exist yet. A relative STOP resolves inside
# the repo, and the delay script will not create it there. Replace
# PROVIDER/MODEL. The child argv has no tools flag. max_rounds is 3.
# There is no core spend knob in this file.

schema_version = 1

[agent]
command = ["PI", "-p", "-na", "--mode", "json", "--model", "PROVIDER/MODEL"]
prompt_arg_template = ["{prompt}"]
name = "pi"
terminal_marker = "\"type\":\"agent_end\""

[agent.env]
PI_OFFLINE = "1"

[runtime]
work_dir = "WORK"
log_dir = "WORK/logs"
round_budget_s = 1800
restart_delay_s = 60
round_log_retention = 0
max_rounds = 3
stop_file = "STOP"

[prompt]
# Index 0 is the standing prompt. The ledger is index 1. Do not use the
# single `file =` form.
files = ["prompts/program.md", "logs/lessons.md"]
inject_context = true

[goal]
ledger = "logs/lessons.md"

[vcs]
# ignore: stash is not the ceiling. The stop file is beside the repo.
dirty_action = "ignore"
stash_idempotency_s = 5
